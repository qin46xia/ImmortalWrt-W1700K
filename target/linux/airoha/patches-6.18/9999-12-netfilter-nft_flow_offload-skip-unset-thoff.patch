From 58d699092a63ad9718b95b3ec07e12e1058ed6b1 Mon Sep 17 00:00:00 2001
From: Bohdan Chubuk <chbgdn@gmail.com>
Date: Sun, 26 Jul 2026 01:24:57 +0300
Subject: [PATCH] netfilter: nft_flow_offload: skip unset thoff

In bridge fastpath cases with double VLAN, PPPoE, or PPPoE-in-Q, the
transport header offset is only valid after nftables has evaluated meta
or another payload expression. Without that, nft_thoff() still returns
zero and skb_header_pointer() would read from the Ethernet header.

Adapted from openwrt-pon 675-09 for the XR1710G tree, rebased onto
the unmodified TCP validation block (no XFRM/SOE flow patch).

Signed-off-by: Bohdan Chubuk <chbgdn@gmail.com>
Signed-off-by: naoki66 <naoki66@qq.com>
---
--- a/net/netfilter/nft_flow_offload.c
+++ b/net/netfilter/nft_flow_offload.c
@@ -97,7 +97,7 @@
 	struct flow_offload *flow;
 	enum ip_conntrack_dir dir;
 	struct nf_conn *ct;
-	int ret;
+	int ret, thoff;
 
 	if (nft_flow_offload_skip(pkt->skb, nft_pf(pkt)))
 		goto out;
@@ -108,8 +108,11 @@
 
 	switch (ct->tuplehash[IP_CT_DIR_ORIGINAL].tuple.dst.protonum) {
 	case IPPROTO_TCP:
-		tcph = skb_header_pointer(pkt->skb, nft_thoff(pkt),
-					  sizeof(_tcph), &_tcph);
+		thoff = nft_thoff(pkt);
+		if (thoff == 0)
+			goto out;
+		tcph = skb_header_pointer(pkt->skb, thoff, sizeof(_tcph),
+					  &_tcph);
 		if (unlikely(!tcph || tcph->fin || tcph->rst ||
 			     !nf_conntrack_tcp_established(ct)))
 			goto out;
