. /lib/uboot-envtools.sh
. /lib/functions.sh

board=$(board_name)

# W1700K boots through the HTTP-recovery chainloader U-Boot, which keeps a
# redundant 0x4000 environment in the ubootenv/ubootenv2 UBI volumes. Older
# images generated the generic 0x1f000 layout; drop those files so the exact
# layout is regenerated below. This must run before the "preserve" block,
# which would otherwise keep the stale files.
case "$board" in
gemtek,w1700k-ubi)
	if [ -e /etc/config/ubootenv ] && [ -e /etc/fw_env.config ] &&
		[ "$(grep -Ec '^/dev/ubi[0-9]+_[0-9]+[[:space:]]+0x0[[:space:]]+0x4000[[:space:]]+0x1f000[[:space:]]+1$' /etc/fw_env.config)" -eq 2 ]; then
		exit 0
	fi
	rm -f /etc/config/ubootenv /etc/fw_env.config /etc/fw_sys.config
	;;
esac

# Preserve customized UCI entries when only the generated file is missing.
if [ -s /etc/config/ubootenv ]; then
	[ -s /etc/fw_env.config ] && exit 0
	config_load ubootenv
	config_foreach ubootenv_add_app_config
	[ -s /etc/fw_env.config ] && exit 0
fi

touch /etc/config/ubootenv

ubootenv_add_ubi_xr1710g() {
	. /lib/upgrade/nand.sh
	local envubi="$(nand_find_ubi ubi)"
	local dev="/dev/$(nand_find_volume "$envubi" ubootenv)"
	local dev2="/dev/$(nand_find_volume "$envubi" ubootenv2)"

	# The XR1710G chainloader U-Boot (YYH2913/http-uboot-xr1710g) uses
	# CONFIG_ENV_SIZE=0x4000 for its redundant UBI environment.  Using the
	# generic 0x1f000 layout makes fw_setenv write an environment whose CRC
	# the U-Boot rejects, so bootcmd changes never take effect.
	ubootenv_add_uci_config "$dev" "0x0" "0x4000" "0x1f000" "1"
	ubootenv_add_uci_config "$dev2" "0x0" "0x4000" "0x1f000" "1"
}

ubootenv_add_ubi_http_recovery() {
	ubootenv_add_ubi_xr1710g
}

case "$board" in
gemtek,xr1710g)
	ubootenv_add_ubi_xr1710g
	;;
gemtek,xr1710g-ubi)
	ubootenv_add_ubi_default
	;;
gemtek,xg2010g-ubi|\
gemtek,xg2010g-2g-ubi|\
gemtek,xg2010g-2g|\
nokia,xg-040g-md-ubi|\
nokia,xg-040g-tf-ubi)
	ubootenv_add_ubi_default
	;;
gemtek,w1700k-ubi)
	ubootenv_add_ubi_http_recovery
	;;
gemtek,xg2010g)
	# The vendor partition table keeps the environment in the non-redundant
	# "uenv" MTD partition (CONFIG_ENV_IS_IN_MTD, offset 0x0, 0x4000 bytes),
	# not in UBI volumes like the OpenWrt U-Boot UBI layout does.
	ubootenv_add_mtd "uenv" "0x0" "0x4000" "0x20000"
	;;
nokia,xg-040g-md)
	ubootenv_add_mtd "u-boot-env" "0x1c000" "0x4000" "0x4000"
	;;
esac

config_load ubootenv
config_foreach ubootenv_add_app_config

exit 0
